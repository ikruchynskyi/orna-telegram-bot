# Copy this file to .env and fill in the values below.
# See README.md for how to obtain each one.

# --- Required -----------------------------------------------------------

# Telegram bot token from @BotFather.
BOT_TOKEN=

# Google Sheets API key (Google Cloud Console -> APIs & Services ->
# Credentials -> Create Credentials -> API key), with the Google Sheets
# API enabled on that project.
SHEETS_API_KEY=

# --- Optional: point at your own Material Forecast spreadsheet ----------
# Defaults to the maintainer's spreadsheet if unset. If you use your own,
# it must keep the same layout: L6:W68, row 6 a header, column L = material
# name, column M = Anguish (outdated mechanic, skipped), columns N-W = the
# 10 active guilds in the order Agony, Despair, Melancholy, Torment, Coral,
# Deepshards, Remembrance, Sparring, Trials, Towers.
# SPREADSHEET_ID=
# SHEET_RANGE=Material Forecast!L6:W68

# --- Optional: local Ollama connection -----------------------------------
# Defaults shown below are what telegram_nlp.py falls back to when unset.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_API_KEY=

# --- Optional: hidden /go command (telegram_go.py) -----------------------
# Not exposed in any command menu on purpose. Needs OLLAMA_API_KEY above
# (used against https://ollama.com, not the local host) plus:
# TAVILY_API_KEY=
# GO_MODEL=gemma4:31b
# YTDLP_PATH=~/yt-dlp_macos
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
#
# Strongly recommended: restrict /go to yourself. Message @userinfobot on
# Telegram to get your numeric user id, comma-separate for more than one.
# Anyone else's /go is silently ignored - no "not authorized" reply, since
# that would itself confirm the hidden command exists.
# GO_ALLOWED_USER_IDS=

# --- Optional: Discord game announcements -> Telegram, in Ukrainian -------
# Follow the official Orna announcement channels into a channel of a Discord
# server YOU own (the "Follow" button on an announcement channel), invite your
# own bot to that server with View Channels + Read Message History, and the bot
# relays each new announcement to every Telegram group/channel it is in,
# translated to Ukrainian. Redeem codes are never translated.
#
# Developer portal -> your application -> Bot -> Reset Token. Turn ON
# "Message Content Intent" on the same page, or every message arrives empty.
# DISCORD_BOT_TOKEN=
#
# The channel the announcements are followed into. Find it with:
#   python3 orna_discord.py discover
# DISCORD_ANNOUNCE_CHANNEL_ID=
