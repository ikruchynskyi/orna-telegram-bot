<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Monthly knowledge refresh (scrapers/refresh.py): the 1st of each month, 04:00.
     Install: cp deploy/com.username.ornarefresh.plist ~/Library/LaunchAgents/ &&
              launchctl load ~/Library/LaunchAgents/com.username.ornarefresh.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.username.ornarefresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/irishdash/AI/venv/bin/python3</string>
        <string>-m</string>
        <string>scrapers.refresh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/irishdash/orna-telegram-bot</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/irishdash/orna-telegram-bot/data/cache/logs/refresh.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/irishdash/orna-telegram-bot/data/cache/logs/refresh.out</string>
</dict>
</plist>
