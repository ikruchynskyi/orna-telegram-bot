# Secrets NEVER enter an image layer. This repo has already leaked a .env
# once (see .gitignore) - an image is even easier to push somewhere public.
.env
.env.*
!.env.dist
.git
.venv/
venv/
AI/
__pycache__/
*.pyc
*.log
# Derived at build/runtime in ~0.3s - no reason to ship 12MB of it.
codex.sqlite3
codex.sqlite3-*
# Caches refetch in seconds; .qa_cache is 6.7MB of committed crawl the
# running bot never reads (only orna_scrape_qa.py does).
.aussies_cache/
.knowledge_cache/
.releases_cache/
.bonuses_cache/
.qa_cache/
